+/* "l2,r2", each 1-254. */
+static int parse_thresholds(const char *text, int out[2]) {
+    for (int i=0;i<2;++i) {
+        if (*text<'0' || *text>'9') return -1;
+        int v=0, len=0;
+        while (*text>='0' && *text<='9') { v=v*10+(*text++-'0'); if (++len>3) return -1; }
